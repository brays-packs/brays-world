		  "BARREL OF APPLES"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:block/barrel_apples"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:block/barrel"
    }
  }
