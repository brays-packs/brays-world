{
  "model": {
    "type": "minecraft:select",
    "cases": [
      {
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "cases": [
            {
              "when": "skeleton",
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/fish/salmon_skeleton_2d"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/fish/salmon_2d"
          }
        },
        "when": [
          "gui",
		  "ground"
        ]
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:custom_model_data",
      "cases": [
        {
          "when": "skeleton",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/fish/salmon_skeleton_hand"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_true": {
          "type": "minecraft:range_dispatch",
          "property": "minecraft:use_duration",
          "remaining": true,
          "scale": 1,
          "entries": [
            {
              "threshold": 20,
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/fish/salmon_eat0"
              }
            },
            {
              "threshold": 15,
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/fish/salmon_eat1"
              }
            },
            {
              "threshold": 8,
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/fish/salmon_eat2"
              }
            },
            {
              "threshold": 3,
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/fish/salmon_eat3"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/fish/salmon_eat3"
          }
        },
        "on_false": {
          "type": "minecraft:model",
          "model": "minecraft:item/fish/salmon_hand"
        }
      }
    },
    "property": "minecraft:display_context"
  }
}