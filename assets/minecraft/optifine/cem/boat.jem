{
	"credit": "Bray was here :)",
	"textureSize": [128, 64],
	"models": [
		{
			"part": "root",
			"id": "root",
			"invertAxis": "xy",
			"translate": [0, 0, 0],
			"animations": [
				{
					"var.delta_x": "pos_x - var.last_x",
					"var.delta_z": "pos_z - var.last_z",
					"var.distance": "if(abs(var.delta_x) > 2 || abs(var.delta_z) > 2, 0, sqrt(var.delta_x*var.delta_x + var.delta_z*var.delta_z))",
					"var.velocity": "if(var.distance > 0.001, var.distance, 0)",
					"var.dot": "-var.delta_x * sin(torad(rot_y)) + var.delta_z * cos(torad(rot_y))",
					"var.is_reversing": "if(var.dot < -0.0001, -1, 1)",
					"var.direction": "if(abs(var.dot) > 0.001, if(var.dot > 0, 1, -1), if(var.direction == 0, 1, var.direction))",
					"var.target_speed": "var.velocity * 7",
					"var.momentum": "if(var.target_speed >= var.momentum, var.momentum + (var.target_speed - var.momentum) * 0.075, if(var.momentum < 0.001, 0, var.momentum * 0.996))",
					"var.spin": "var.spin + (var.momentum * var.is_reversing)",
					"propeller.rz": "var.spin",
					"engine_jitter.rx": "sin(time * (var.momentum)) * (if(var.momentum > 0.025, 0.06, 0))",
					"var.last_x": "pos_x",
					"var.last_z": "pos_z"
				}
			]
		},
		{
			"part": "front",
			"id": "front",
